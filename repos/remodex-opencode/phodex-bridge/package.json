{
  "name": "remodex",
  "version": "1.5.6",
  "description": "Local bridge between Codex and the Remodex mobile app. Run `remodex up` to start.",
  "keywords": [
    "bridge",
    "cli",
    "codex",
    "remodex"
  ],
  "license": "Apache-2.0",
  "author": "Emanuele Di Pietro",
  "bin": {
    "remodex": "./bin/remodex.js",
    "remodex-jsonl-diagnose": "./bin/remodex-jsonl-diagnose.js"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node ./bin/remodex.js up",
    "test": "node --test ./test/*.test.js",
    "lint": "node ./node_modules/oxlint/bin/oxlint",
    "fmt": "node ./node_modules/oxfmt/bin/oxfmt",
    "fmt:check": "node ./node_modules/oxfmt/bin/oxfmt --check",
    "postinstall": "node ./src/bootstrap-codex-cli.js",
    "prepack": "node ./scripts/prepare-private-defaults.js",
    "postpack": "node ./scripts/cleanup-private-defaults.js"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.11",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0"
  }
}
